{
  "name": "convoy",
  "version": "0.3.0",
  "description": "Convoy — ride together. Passenger-side multiplayer map app.",
  "private": true,
  "scripts": {
    "test": "node test/run.js",
    "test:frontend": "node test/frontend.test.js",
    "serve": "node server/server.js",
    "copy-web": "node scripts/copy-web.js",
    "android:add": "npm run copy-web && cap add android",
    "android:sync": "npm run copy-web && cap sync android",
    "android:open": "cap open android",
    "test:blocking": "node test/block-integration.js",
    "test:race": "node test/race-lifecycle.js",
    "test:fuzz": "node test/ws-fuzz.js",
    "test:concurrent": "node test/concurrency.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "acorn-globals": "^7.0.1",
    "axe-core": "^4.13.0",
    "html-validate": "^11.12.0",
    "jsdom": "^30.0.1"
  }
}
