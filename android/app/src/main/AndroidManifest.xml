<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- minSdkVersion is 24, and android:usesCleartextTraffic only defaults to
         FALSE from API 28. On Android 7.0-8.1 the platform would otherwise permit
         plain http, so state it explicitly rather than inheriting a default that
         depends on the device. The page CSP (connect-src https: wss:) already
         refuses cleartext from the web layer; this closes the same door natively. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Social sign-in comes back through here. The provider round-trip
                 runs in a Custom Tab (see AuthPlugin — Google refuses OAuth in an
                 embedded WebView), and the WebView's own https://localhost origin
                 is not somewhere anyone can redirect TO. So the flow ends at a
                 scheme this app owns, and Android delivers it to MainActivity.

                 launchMode="singleTask" above is load-bearing: it brings the
                 EXISTING activity forward and delivers this through
                 onNewIntent — clearing the Custom Tab that sits above it —
                 rather than starting a second copy of the app on top of the one
                 that is midway through signing in.

                 The host is pinned to "auth" so this claims one specific link
                 shape and not every tech.odoreeci.convoy:// URI. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tech.odoreeci.convoy" android:host="auth" />
            </intent-filter>

            <!-- App Links: the links Convoy EMAILS (password reset, email
                 confirmation, passwordless sign-in, email change). Opened on a
                 phone with the app installed, Android hands them straight here
                 instead of to a browser.

                 autoVerify="true" is what makes that automatic and silent: at
                 install time Android fetches
                 https://odoreeci.tech/.well-known/assetlinks.json and only
                 honours this filter if the certificate THIS APK is signed with
                 is listed there (the server builds that file — see
                 ANDROID_CERT_SHA256). Fail verification and nothing breaks; the
                 links just keep opening in the browser, which still works.

                 pathPrefix="/l" is deliberate and load-bearing. App Links match
                 on PATH ONLY — query strings are ignored — so claiming the
                 mailed links in their old "/?cv=reset&token=…" shape would have
                 meant claiming "/", i.e. every link to the website, the APK
                 download page included. Emails point at /l/<kind> so the claim
                 covers those four links and nothing else. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="odoreeci.tech" android:pathPrefix="/l" />
                <data android:scheme="https" android:host="www.odoreeci.tech" android:pathPrefix="/l" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Foreground location service: keeps GPS fixes flowing while backgrounded. -->
        <service
            android:name=".LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GPS (high-accuracy rider positions + GPS status indicator) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Foreground location service (keeps live feed running with screen off) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Walkie-talkie voice (convoy push-to-talk / open mic / toggle, and
         proximity voice with riders around you) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Location hardware is what the app is for, but a tablet without GPS can
         still ride along as a passenger map — so it stays optional for Play's
         device catalogue. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Package visibility (Android 11+). -->
    <queries>
        <!-- Custom Tabs (social sign-in). Under Android 11+ package visibility a
             browser the app cannot SEE is a browser it cannot launch: without
             this, CustomTabsIntent finds no provider and every provider sign-in
             falls back to a plain VIEW intent — or, on a device with no default
             browser resolved, fails outright. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
